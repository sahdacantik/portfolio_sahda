---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import portrait from '../assets/photos/portrait.png';
import labAssistants from '../assets/photos/lab-assistants.webp';
import { education, journey, organization, profile, url } from '../data/site';
---

<Base title="About" description="Background, education, and organization experience of Sahda Rahani Susilawati.">
  <section class="grid items-start gap-8 py-14 md:grid-cols-[auto_1fr] md:gap-12">
    <Image src={portrait} alt={`Portrait of ${profile.name}`} widths={[176, 352]} sizes="176px" class="size-44 rounded-token bg-accent-soft object-cover" />
    <div class="max-w-2xl">
      <p class="eyebrow">About</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight">{profile.name}</h1>
      <div class="mt-5 space-y-4 text-pretty text-muted">
        <p>I'm a Computer Science graduate from Universitas Pakuan, currently working as a frontend engineer intern.</p>
        <p>Throughout my studies, I worked on web and mobile applications, machine learning and computer vision projects, data analysis, and digital product design. I enjoy exploring a project from different perspectives: understanding the problem, designing the solution, developing the system, and turning ideas into functional digital products.</p>
        <p>I'm always looking for opportunities to learn, solve real-world problems, and create technology that is useful and meaningful.</p>
      </div>
    </div>
  </section>

  <section class="py-12">
    <SectionHeading label="Education" title={education.degree} />
    <div class="card p-5 sm:p-6">
      <p class="font-semibold">{education.school}</p>
      <p class="mt-1 font-mono text-xs text-muted">{education.period} · GPA {education.gpa}</p>
      <p class="mt-4 text-sm text-muted">Undergraduate thesis</p>
      <p class="mt-1 text-pretty">{education.thesis}</p>
      <a href={url('projects/egg-crack-detection/')} class="mt-4 inline-block text-sm font-medium text-accent hover:underline">
        See the thesis project <span aria-hidden="true">→</span>
      </a>
    </div>
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        journey.map((step) => (
          <li class="border-t-2 border-accent pt-3">
            <p class="font-mono text-xs text-accent">{step.year}</p>
            <h3 class="mt-1 font-medium">{step.title}</h3>
            <p class="mt-1 text-sm text-pretty text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="py-12">
    <SectionHeading label="Organization" title="Campus involvement" />
    <div class="grid gap-5 lg:grid-cols-2">
      <div class="space-y-4">
        {
          organization.map((item) => (
            <div class="card p-5">
              <p class="font-mono text-xs text-muted">{item.period}</p>
              <h3 class="mt-1 font-semibold">{item.role}</h3>
              <p class="text-sm text-muted">{item.org}</p>
              <p class="mt-3 text-sm text-pretty">{item.text}</p>
            </div>
          ))
        }
      </div>
      <Image src={labAssistants} alt="Group photo of the Universitas Pakuan lab assistants" widths={[600, 1000]} sizes="(min-width: 1024px) 560px, 100vw" class="h-full w-full rounded-token border border-line object-cover" />
    </div>
  </section>
</Base>
