---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { url } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, tagline, category, context, role, stack, features, outcome, metrics, links } = project.data;
---

<Base title={title} description={`${title}: ${tagline}.`}>
  <article class="py-10 sm:py-14">
    <a href={url('projects/')} class="font-mono text-xs text-muted hover:text-fg"><span aria-hidden="true">←</span> All projects</a>

    <header class="mt-6 max-w-3xl">
      <p class="eyebrow">{category} · {context}</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{title}</h1>
      <p class="mt-3 text-lg text-muted">{tagline}</p>
    </header>

    <div class="card mt-8 overflow-hidden">
      <ProjectVisual project={project} priority detail />
    </div>

    {
      metrics && (
        <dl class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-4">
          {metrics.map((metric) => (
            <div class="card p-4">
              <dt class="text-xs text-muted">{metric.label}</dt>
              <dd class="mt-1 text-xl font-semibold text-accent">{metric.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="mt-10 grid gap-10 lg:grid-cols-[1.6fr_1fr] lg:gap-14">
      <div class="space-y-10">
        <section>
          <h2 class="font-mono text-sm text-accent">Overview</h2>
          <div class="mt-3 text-pretty"><Content /></div>
        </section>
        <section>
          <h2 class="font-mono text-sm text-accent">Features</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5 marker:text-accent">
            {features.map((feature) => <li>{feature}</li>)}
          </ul>
        </section>
        <section>
          <h2 class="font-mono text-sm text-accent">Outcome</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5 marker:text-accent">
            {outcome.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>

      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        <section>
          <h2 class="font-mono text-sm text-accent">My role</h2>
          <p class="mt-3 text-sm text-pretty text-muted">{role}</p>
        </section>
        <section>
          <h2 class="font-mono text-sm text-accent">Tech stack</h2>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {stack.map((tech) => <li class="chip">{tech}</li>)}
          </ul>
        </section>
        {
          (links.live || links.repo) && (
            <div class="flex flex-wrap gap-3">
              {links.live && <a href={links.live} target="_blank" rel="noopener" class="btn btn-primary">Live demo</a>}
              {links.repo && <a href={links.repo} target="_blank" rel="noopener" class="btn">GitHub</a>}
            </div>
          )
        }
      </aside>
    </div>
  </article>
</Base>
