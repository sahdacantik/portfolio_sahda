---
import { nav, url } from '../data/site';

const home = url();
const isHome = Astro.url.pathname.replace(/\/$/, '') === home.replace(/\/$/, '');
const href = (target: string) => (target.startsWith('#') ? (isHome ? target : `${home}${target}`) : url(target));
---

<header class="sticky top-0 z-30 border-b border-line bg-bg/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <a href={home} class="font-mono text-sm font-medium whitespace-nowrap">
      <span class="text-accent">&lt;</span>sahda<span class="text-accent"> /&gt;</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-6 text-sm text-muted md:flex">
      {nav.map((item) => <a href={href(item.href)} class="transition-colors hover:text-fg">{item.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-palette-open
        aria-label="Open command palette"
        class="flex h-10 items-center gap-2 rounded-token border border-line bg-surface px-3 text-sm text-muted transition-colors hover:border-accent"
      >
        <span class="md:hidden">Menu</span>
        <span class="hidden md:inline">Search</span>
        <kbd class="hidden font-mono text-xs md:inline">Ctrl K</kbd>
      </button>
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle light and dark theme"
        class="grid size-10 place-items-center rounded-token border border-line bg-surface text-muted transition-colors hover:border-accent"
      >
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.800 9.800Z"></path></svg>
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.900 4.900l1.400 1.400M17.700 17.700l1.400 1.400M2 12h2M20 12h2M4.900 19.100l1.400-1.400M17.700 6.300l1.400-1.400"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  import { toggleTheme } from '../scripts/theme';

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', toggleTheme);
</script>
