---
import { nav, url } from '../data/site';

const home = url();
const isHome = Astro.url.pathname.replace(/\/$/, '') === home.replace(/\/$/, '');
const href = (target: string) => (target.startsWith('#') ? (isHome ? target : `${home}${target}`) : url(target));
const iconButton =
  'grid size-10 place-items-center rounded-token border border-line bg-surface text-muted transition-colors hover:border-accent';
---

<header class="sticky top-0 z-30 border-b border-line bg-bg/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <a href={home} class="text-lg font-semibold tracking-tight">Sahda</a>

    <nav aria-label="Main" class="hidden items-center gap-6 text-sm text-muted md:flex">
      {nav.map((item) => <a href={href(item.href)} class="transition-colors hover:text-fg">{item.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <button type="button" data-theme-toggle aria-label="Toggle light and dark theme" class={iconButton}>
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.800 9.800Z"></path></svg>
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.900 4.900l1.400 1.400M17.700 17.700l1.400 1.400M2 12h2M20 12h2M4.900 19.100l1.400-1.400M17.700 6.300l1.400-1.400"></path></svg>
      </button>
      <button type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" class:list={[iconButton, 'md:hidden']}>
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Main" hidden class="border-t border-line px-4 py-2 md:hidden">
    {nav.map((item) => <a href={href(item.href)} class="block py-3 text-muted transition-colors hover:text-fg">{item.label}</a>)}
  </nav>
</header>

<script>
  import { toggleTheme } from '../scripts/theme';

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', toggleTheme);

  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const mobileNav = document.querySelector<HTMLElement>('#mobile-nav')!;

  function setMenu(open: boolean) {
    mobileNav.hidden = !open;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  menuButton.addEventListener('click', () => setMenu(mobileNav.hidden));
  // Anchor links stay on the page, so close the menu after picking one.
  mobileNav.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !mobileNav.hidden) {
      setMenu(false);
      menuButton.focus();
    }
  });
</script>
