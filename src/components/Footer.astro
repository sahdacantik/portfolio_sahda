---
import { profile, socials } from '../data/site';
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <ul class="flex gap-4">
      {
        socials.map((social) => (
          <li>
            <a href={social.href} target="_blank" rel="noopener" class="transition-colors hover:text-fg">
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
